{
  "gentleman-deep-semi": {
    "description": "Deep reasoning — SEMI mode (safe commands auto, writes/commits ask)",
    "model": "opencode/nemotron-3-ultra-free",
    "mode": "primary",
    "prompt": "{file:prompts/gentleman-deep.md}\n\n{file:prompts/shared/_core-behavior-gp.md}",
    "permission": {
      "bash": {
        "*": "ask",
        "Get-ChildItem *": "allow",
        "Get-Command *": "allow",
        "Get-Content *": "allow",
        "Get-Location *": "allow",
        "Select-String *": "allow",
        "Test-Path *": "allow",
        "Write-Output *": "allow",
        "cat *": "allow",
        "dir *": "allow",
        "echo *": "allow",
        "findstr *": "allow",
        "git branch *": "allow",
        "git diff *": "allow",
        "git log *": "allow",
        "git show *": "allow",
        "git stash list": "allow",
        "git stash show *": "allow",
        "git status *": "allow",
        "grep *": "allow",
        "ls *": "allow",
        "npm test *": "allow",
        "npm run *": "allow",
        "npm ci *": "allow",
        "pip freeze *": "allow",
        "pip list *": "allow",
        "pip show *": "allow",
        "pwd *": "allow",
        "pytest *": "allow",
        "cargo test *": "allow",
        "dotnet test *": "allow",
        "go test *": "allow",
        "Invoke-Pester *": "allow",
        "rg *": "allow",
        "which *": "allow",
        "git branch -D *": "ask",
        "git stash drop *": "ask",
        "$import": "scripts/opencode-config/shared-deny-rules.json"
      }
    },
    "tools": {
      "codebase-memory*": true,
      "engram*": true
    }
  },
